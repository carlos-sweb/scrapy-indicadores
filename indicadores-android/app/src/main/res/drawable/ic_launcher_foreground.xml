<?xml version="1.0" encoding="utf-8"?>
<!-- Lucide "trending-up" (https://lucide.dev/icons/trending-up), ISC
     license, fetched via the official lucide-static npm package. Replaced
     the hand-drawn bar chart 2026-09-10 — three people shown just the old
     icon guessed "network/wifi signal", not "economic indicators". A
     trending-up line reads unambiguously as growth/finance and — unlike a
     dollar-sign badge — doesn't imply the app is USD-specific (it also
     tracks UF, Euro, Yen, oro, plata, cobre).
     Original path data is in a 24x24 viewBox; the enclosing <group> scales
     it 2.1667x and centers it in our 108x108 canvas, landing well inside
     the 66dp adaptive-icon safe zone (21-87) with generous padding on every
     side — same lesson as the bar-chart version's padding fix. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="28"
        android:translateY="28"
        android:scaleX="2.1667"
        android:scaleY="2.1667">
        <path
            android:pathData="M16,7h6v6"
            android:strokeColor="#6EE7B7"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M22,7 L13.5,15.5 8.5,10.5 2,17"
            android:strokeColor="#6EE7B7"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
